VITE_APP_MODE=local
# Supabase 실제 저장을 사용하려면 VITE_APP_MODE=supabase로 변경하세요.
# Supabase 연결 (선택사항, 생략 시 로컬 모드)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Geoapify API 키 (없어도 예약은 가능하며 지점 목록으로 동작합니다)
VITE_GEOAPIFY_API_KEY=your-geoapify-api-key
VITE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# 개발 서버 포트
VITE_PORT=5187

# 운영 시각은 기기 현재 시각을 사용합니다. 고정 시각 환경 변수는 없습니다.
